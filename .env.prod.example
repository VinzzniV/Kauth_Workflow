PUBLIC_HOSTNAME=onboarding-test.example.local
# Must match the public HTTPS URL and the Entra SPA redirect URI.
PUBLIC_BASE_URL=https://onboarding-test.example.local
# compose.prod.yml mirrors PUBLIC_BASE_URL into the web runtime config as ENTRA_REDIRECT_URI.

WEB_BIND_HOST=0.0.0.0
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

POSTGRES_DB=appdb
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me

ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_AUDIENCE=api://00000000-0000-0000-0000-000000000000
# At least one of ENTRA_CLIENT_SECRET or GRAPH_CLIENT_SECRET must be set.
# GRAPH_CLIENT_SECRET is only an optional secret override for Graph/Mail while tenant and client ID stay on ENTRA_*.
ENTRA_CLIENT_SECRET=
GRAPH_CLIENT_SECRET=

DIRECTORY_GROUP_PREFIX=Onboarding-App-
DIRECTORY_EXPLICIT_GROUP_IDS=
DIRECTORY_SYNC_SCHEDULED=true
# Sync-Interval in Minuten. Der Sync aktualisiert nur Identitätsdaten (wer existiert, welche Gruppen).
# Zuständigkeiten (Abteilungsleitung) werden nicht automatisch gesetzt — Zuweisung erfolgt manuell im Admin-Panel.
# Empfohlen: 60 (stündlich) bis 480 (alle 8h). Manueller Trigger jederzeit über POST /admin/directory/sync.
DIRECTORY_SYNC_INTERVAL_MINUTES=60
SWAGGER_ENABLED=false

# Linux-Host-/VM-Metriken im Admin-Dashboard (optional).
# Aktiviere wenn die API auf einer Linux-VM laeuft und der Host-Block im Dashboard erscheinen soll.
# compose.prod.yml mountet /proc als /host-proc und / als /host-root (readonly) in den API-Container.
# HOST_RUNTIME_HEALTH_ENABLED=true
# HOST_RUNTIME_PROCFS_PATH=/host-proc
# HOST_RUNTIME_ROOT_PATH=/host-root